# Linux-only offline sandbox for reviewing proposed BCC code changes.
# Build explicitly in the existing Codespace. This image is NOT used by live bots.
# Pin the resulting local image ID (sha256:...) for subsequent review runs.
FROM python:3.12.16-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    QT_QPA_PLATFORM=offscreen \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       libgl1 libegl1 libopengl0 libglib2.0-0 libdbus-1-3 libfontconfig1 \
       libxkbcommon-x11-0 libxcb-cursor0 libxcb-xinerama0 \
       libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-render-util0 \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir \
    pytest==9.2.0 \
    PySide6==6.12.0 \
    requests==2.34.2 \
    psutil==7.2.2 \
    websocket-client==1.9.2

# Never put credentials, checkout sources, GitHub tokens or trading DBs in image.
WORKDIR /src
